<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.josephjohncox.pi-acp</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BIN@</string>
		<string>--daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>@HOME@/.pi/agent/logs/pi-acp-daemon.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.pi/agent/logs/pi-acp-daemon.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>PATH</key>
		<string>@PATH@</string>
	</dict>
</dict>
</plist>
